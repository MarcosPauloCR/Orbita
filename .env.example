# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# Portão de disfarce — código secreto que libera o acesso em "/"
SECRET_GATE_CODE=troque-por-um-codigo-so-de-voces

# Sessão — segredo usado para assinar os cookies (gate + login).
# Gere um valor forte, ex: openssl rand -base64 32
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Usuários — não ficam mais no .env. São gravados na tabela `users` do
# Supabase com:
#   npm run set-user -- <id> <senha> ["Nome de exibição"]
# A senha pode ser trocada depois pela própria interface do app (/app/senha).

# Web Push (notificações) — gerar par de chaves com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT=mailto:voce@exemplo.com
VAPID_PRIVATE_KEY=xxxxxxxxxxxx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxx
